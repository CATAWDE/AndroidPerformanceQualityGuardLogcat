<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android Performance &amp; Quality Guard"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Runtime checks run when this screen opens. Tap below to simulate an API burst and see PG003 in Logcat. Run the Gradle scanner for file/source checks."
            android:textSize="16sp" />

        <Button
            android:id="@+id/simulate_api_burst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Simulate 12 API calls" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Logcat filter: QualityGuard. Gradle source scanner: qualityGuardScan. Findings are heuristic and require developer review." />
    </LinearLayout>
</ScrollView>
